{
  "contractVersion": 3,
  "showId": "spatial-demo",
  "name": "Spatial Demo (Phase A)",
  "floorplan": { "width": 640, "height": 420 },
  "globals": {
    "showStartedAt": { "type": "number", "initial": 0 }
  },
  "rooms": {
    "library": {
      "name": "Library",
      "zones": {
        "library-main": {
          "polygon": [[120, 80], [280, 80], [280, 200], [120, 200]],
          "label": [200, 140]
        },
        "library-alcove": {
          "polygon": [[280, 100], [330, 100], [330, 170], [280, 170]],
          "label": [305, 135]
        }
      },
      "machine": {
        "id": "library",
        "initial": "idle",
        "states": {
          "idle": {
            "on": {
              "ACTIVATE": "activating",
              "ACTIVATE_SEEN": "active.abbreviated"
            }
          },
          "activating": {
            "on": { "READY": "active", "RELEASE": "settling" },
            "after": { "1200": { "target": "active" } }
          },
          "active": {
            "initial": "main",
            "on": { "RELEASE": "settling" },
            "states": {
              "main": { "on": { "DONE": "#library.settling" } },
              "abbreviated": { "on": { "DONE": "#library.settling" } }
            }
          },
          "settling": {
            "on": {
              "RESET": "idle",
              "RESUME": "active.main",
              "ACTIVATE": "active.main",
              "ACTIVATE_SEEN": "active.abbreviated"
            }
          }
        }
      },
      "multiGuest": {
        "policy": "collaborative",
        "maxOccupants": 6,
        "atCapacity": "spectator"
      },
      "ineligible": { "policy": "ambientOnly" },
      "exit": {
        "policy": "resetAfter",
        "graceMs": 10000,
        "audioOnExit": "fadeOut",
        "resumeIfReturned": true
      },
      "audio": {
        "timing": "masterTimeline",
        "joinPolicy": "inProgress",
        "minRemainingMs": 20000
      },
      "seen": { "dwellMs": 20000, "accumulate": true },
      "revisit": { "whenSeen": {} },
      "location": { "entryConfirmMs": 1500, "exitConfirmMs": 800 }
    },
    "greenhouse": {
      "name": "Greenhouse",
      "zones": {
        "greenhouse": {
          "polygon": [[360, 80], [520, 80], [520, 200], [360, 200]],
          "label": [440, 140]
        }
      },
      "machine": {
        "id": "greenhouse",
        "initial": "idle",
        "states": {
          "idle": { "on": { "ACTIVATE": "active" } },
          "active": {
            "on": { "RELEASE": "settling" },
            "after": { "5000": { "target": "settling" } }
          },
          "settling": { "on": { "RESET": "idle", "ACTIVATE": "active" } }
        }
      },
      "multiGuest": {
        "policy": "spectator",
        "maxOccupants": 2,
        "atCapacity": "spectator"
      },
      "ineligible": { "policy": "ignore" },
      "exit": { "policy": "finish", "audioOnExit": "continue" },
      "seen": { "dwellMs": 15000, "accumulate": true },
      "location": { "entryConfirmMs": 1500, "exitConfirmMs": 800 }
    },
    "cellar": {
      "name": "Cellar",
      "zones": {
        "cellar": {
          "polygon": [[220, 240], [380, 240], [380, 360], [220, 360]],
          "label": [300, 300]
        }
      },
      "machine": {
        "id": "cellar",
        "initial": "idle",
        "states": {
          "idle": { "on": { "ACTIVATE": "active" } },
          "active": {
            "initial": "main",
            "on": { "RELEASE": "settling" },
            "states": {
              "main": {},
              "inverted": {}
            }
          },
          "settling": { "on": { "RESET": "idle", "ACTIVATE": "active.main" } }
        }
      },
      "multiGuest": { "policy": "refuse", "maxOccupants": 1, "atCapacity": "refuse" },
      "ineligible": { "policy": "lockedMessage", "audio": "cellar-locked" },
      "exit": { "policy": "resetImmediate" },
      "seen": { "dwellMs": 10000, "accumulate": false },
      "location": { "entryConfirmMs": 1500, "exitConfirmMs": 800 }
    }
  },
  "guest": {
    "eligibility": {
      "golden": { "strategy": "goldenPath", "params": { "allowRevisit": true } }
    }
  },
  "phases": [
    {
      "id": "roamA",
      "mode": "freeRoam",
      "rooms": "pathAssigned",
      "advanceWhen": { "scope": "guest", "seenCount": 2 }
    },
    {
      "id": "converge",
      "mode": "directed",
      "target": "library",
      "advanceWhen": { "scope": "show", "entered": "library" }
    },
    {
      "id": "exit",
      "mode": "directed",
      "target": "library"
    }
  ],
  "paths": {
    "assignment": { "strategy": "roundRobin", "at": "onJoin" },
    "definitions": {
      "pathA": {
        "rooms": ["library", "greenhouse"],
        "guidance": "goldenPath"
      },
      "pathB": {
        "rooms": ["library", "cellar"],
        "guidance": "goldenPath"
      }
    }
  },
  "adherence": {
    "signals": {
      "ineligibleRoomEntered": { "weight": 25 },
      "guidanceIgnoredMs": { "weight": 10, "per": 60000 }
    },
    "compliance": {
      "eligibleRoomSeen": { "weight": -30 },
      "guidedRoomEntered": { "weight": -40 }
    },
    "thresholds": { "drifting": 30, "cursed": 75 },
    "redemption": { "policy": "reversible", "hysteresisMs": 30000 },
    "cursedIsSticky": false
  },
  "inputBindings": {
    "button:activate": { "event": "mechanism.pull", "scope": "room" }
  },
  "location": {
    "entryConfirmMs": 1500,
    "exitConfirmMs": 800,
    "contactLossMs": 5000
  }
}
